# Gemini API key - get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use
GEMINI_MODEL=gemini-1.5-flash

# Database URL (SQLite file stored in /data)
DATABASE_URL=sqlite:///./data/fitbuddy.db

# App server settings
APP_HOST=127.0.0.1
APP_PORT=8000

# Set to true for verbose debug logging
DEBUG=true